<?xml version="1.0" ?>
<launch>
  <arg name="sim" default="true" />
  <arg name="launch_rviz" default="true" />

  <!-- Load parameters for woosh real robot -->
  <rosparam command="load" file="$(find active_grasp)/cfg/active_grasp_woosh.yaml" subst_value="true" />

  <!-- Launch MoveIt (still using panda for simulation, but base_frame is woosh_base_link) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="to_panda" args="0 0 0 0 0 0  world panda_link0" />
  <!-- Publish woosh_base_link (needed for TF bridge) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="to_woosh_base" args="0 0 0 0 0 0  world woosh_base_link" />
  <include file="$(find panda_moveit_config)/launch/move_group.launch">
    <arg name="transmission" value="position" />
  </include>

  <!-- Simulated environment (using real camera data via ros1_bridge) -->
  <group if="$(arg sim)">
    <param name="robot_description" command="$(find xacro)/xacro $(find active_grasp)/assets/franka/panda_arm_hand.urdf.xacro" />
    <node pkg="active_grasp" type="bt_sim_node.py" name="bt_sim" output="screen" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
    <!-- TF bridge: 订阅话题，发布 TF -->
    <node pkg="active_grasp" type="tf_bridge_ros1.py" name="tf_bridge_ros1" output="screen" />
  </group>

  <!-- Real environment (not used for woosh, but kept for compatibility) -->
  <group unless="$(arg sim)">
    <node pkg="active_grasp" type="hw_node.py" name="hw" output="screen" />
  </group>

  <!-- Launch rviz -->
  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find active_grasp)/cfg/active_grasp.rviz" />
</launch>
